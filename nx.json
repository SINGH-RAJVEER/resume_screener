{
    "defaultBase": "main",
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "sharedGlobals": ["{workspaceRoot}/.env"]
    },
    "targetDefaults": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["default", "^default", "{workspaceRoot}/.env*"],
            "outputs": ["{projectRoot}/dist/**"],
            "cache": true
        },
        "dev": {
            "cache": false,
            "continuous": true
        },
        "lint": {
            "dependsOn": ["^lint"],
            "cache": true
        },
        "typecheck": {
            "dependsOn": ["^typecheck"],
            "cache": true
        }
    },
    "analytics": true
}
