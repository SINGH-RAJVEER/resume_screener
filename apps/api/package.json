{
	"name": "@skillsignal/api",
	"private": true,
	"version": "0.0.1",
	"scripts": {
		"dev": "uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
		"build": "uv sync --locked",
		"start": "uv run uvicorn app.main:app --host 0.0.0.0 --port 8000",
		"test": "LD_LIBRARY_PATH=\"${NIX_LD_LIBRARY_PATH:-${LD_LIBRARY_PATH:-}}\" uv run pytest",
		"typecheck": "uv run pyright",
		"lint": "uv run ruff check .",
		"format": "uv run ruff format ."
	}
}
