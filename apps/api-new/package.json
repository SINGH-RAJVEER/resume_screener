{
	"name": "@skillsignal/api-new",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target bun",
		"start": "bun src/index.ts",
		"typecheck": "tsgo --noEmit",
		"lint": "biome check src/",
		"db:generate": "bunx drizzle-kit generate --config ../../libs/server-core/drizzle.config.ts"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.7.5",
		"@skillsignal/server-core": "workspace:*",
		"bcryptjs": "^3.0.2",
		"drizzle-orm": "^0.44.7",
		"fflate": "^0.8.3",
		"hono": "^4.9.7",
		"jose": "^6.1.0",
		"zod": "^4.1.5"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0"
	}
}
