{
	"name": "skillsignal",
	"private": true,
	"workspaces": [
		"apps/*",
		"libs/*"
	],
	"scripts": {
		"build": "bun run --workspaces --if-present --parallel build",
		"dev": "bun run --workspaces --if-present --parallel dev",
		"lint": "bun run --workspaces --if-present --parallel lint",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"typecheck": "bun run --workspaces --if-present --parallel typecheck",
		"test": "bun run --workspaces --if-present --parallel test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@typescript/native-preview": "7.0.0-dev.20260707.2"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"packageManager": "bun@1.4.0"
}
