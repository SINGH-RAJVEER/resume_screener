# Postgres (used by docker-compose)
# POSTGRES_PASSWORD is required by docker-compose; the rest have defaults.
POSTGRES_DB=skillsignal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Database
# The API accepts either DATABASE_URL directly, or the individual
# DATABASE_* variables below. The worker always needs DATABASE_URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillsignal

# Required (API) when DATABASE_URL is not set
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=skillsignal
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# Auth (API)
# JWT_SECRET is required, at least 32 characters.
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional. Duration format: <number><ms|s|m|h>. Default: 168h
JWT_TTL=168h

# Storage (API + worker)
# Optional. Default: .local-storage
STORAGE_ROOT=.local-storage

# URLs
# Optional. Default: http://localhost:3000
WEB_URL=http://localhost:3000

# Worker tuning
# Optional. Defaults shown.
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=60
PARSE_TIMEOUT_SECONDS=30

# OpenRouter (worker)
# Without OPENROUTER_API_KEY the worker falls back to deterministic
# scoring and no LLM extraction. Defaults shown for the rest.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EXTRACTION_MODEL=openai/gpt-5-mini
OPENROUTER_ASSESSMENT_MODEL=openai/gpt-5-mini
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_OUTPUT_TOKENS=4096

# OpenTelemetry (API + worker)
# Tracing and metrics stay off until OTEL_EXPORTER_OTLP_ENDPOINT is set.
# The exporters append /v1/traces and /v1/metrics to the base endpoint.
# Standard OTEL variables are honored, e.g.:
#   OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <token>
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Web (build time, passed via VITE_API_URL in docker-compose)
# Optional. Default: http://localhost:8000
VITE_API_URL=http://localhost:8000

# Points and Razorpay (API + worker; worker reads only the point variables)
# Optional. Defaults shown.
POINTS_PER_USD=1000
MIN_POINTS_INDEPENDENT_EVALUATION=10
MIN_POINTS_EMPLOYER_RESUME=5
PRICE_CEILING_INPUT_USD_PER_MILLION=3.0
PRICE_CEILING_OUTPUT_USD_PER_MILLION=15.0

# Razorpay (API). Without key credentials, order creation answers 503
# and webhooks stay disabled. Packs are a JSON array of
# {id, points, amountInr}.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PACKS=[{"id":"pack-500","points":500,"amountInr":499},{"id":"pack-2000","points":2000,"amountInr":1499}]

# Operator token for manual enterprise entitlement provisioning (API).
# Leave empty to disable the admin endpoints entirely.
ADMIN_TOKEN=
ENTERPRISE_SALES_EMAIL=sales@example.com
